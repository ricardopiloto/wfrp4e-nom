        "scriptData": [
          {
            "script": "const AP = args?.AP;\nif (!AP) return;\nconst bump = (loc) => {\n  if (AP.locations?.[loc]?.value != null) AP.locations[loc].value += 1;\n  else if (AP[loc]?.value != null) AP[loc].value += 1;\n};\nbump(\"head\");",
            "label": "Head AP +1",
            "trigger": "APCalc",
            "options": {
              "targeter": false,
              "defending": false,
              "runIfDisabled": false,
              "hideScript": "",
              "deleteEffect": false,
              "showDuplicates": false
            },
            "async": false
          },
          {
            "script": "(async () => {\n  const horns = await fromUuid(\"Compendium.wfrp4e-core.items.BqPZn6q3VHn9HUrW\");\n  if (!horns) return;\n  const data = horns.toObject();\n  const sb = Number(this.actor.system.characteristics.s.bonus) || 0;\n  if (foundry.utils.hasProperty(data, \"system.specification.value\")) {\n    foundry.utils.setProperty(data, \"system.specification.value\", sb + 4);\n  }\n  await this.actor.createEmbeddedDocuments(\"Item\", [data], { fromEffect: this.effect.id });\n})();",
            "label": "Horns (SB+4)",
            "trigger": "addItems",
            "options": {
              "targeter": false,
              "defending": false,
              "runIfDisabled": false,
              "hideScript": "",
