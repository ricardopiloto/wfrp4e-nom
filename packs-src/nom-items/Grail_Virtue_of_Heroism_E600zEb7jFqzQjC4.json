  "system": {
    "description": {
      "type": "String",
      "label": "Description",
      "value": "<p>If you inflict Damage on an opponent, you deal an additional number of Wounds equal to the opponent&rsquo;s Armor Points on that location. In addition, if you deal any Melee Damage to non-metal armor, armor has no effect in Damage reduction for the creature.</p>\n<p><strong>Grail Virtue :</strong> You gain a permanent +5 bonus to your Strength and Toughness Characteristics this does not count towards your Advances; moreover, you gain the @Compendium[wfrp4e-core.items.SfUUdOGjdYpr3KSR]{Regenerate} Trait and the @Compendium[wfrp4e-core.items.3wCtgMDNnu8MFmyk]{Immunity (Corruption, Disease, Fatigue, Poison)} Trait.</p>"
    },
