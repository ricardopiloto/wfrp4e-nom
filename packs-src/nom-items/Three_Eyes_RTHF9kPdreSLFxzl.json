        "scriptData": [
          {
            "script": "(async () => {\n  try {\n    const talent = await WFRP_Utility.findItem(game.i18n.localize(\"NAME.AcuteSense\"), \"talent\");\n    if (!talent) return;\n    const data = talent.toObject();\n    const sense = game.i18n.localize(\"Sense\");\n    if (data.system?.tests?.value && sense) {\n      data.system.tests.value = String(data.system.tests.value).replace(sense, \"Vision\");\n    }\n    data.name = game.i18n.localize(\"NAME.AcuteSense\") + \" (Vision)\";\n    await this.actor.createEmbeddedDocuments(\"Item\", [data], { fromEffect: this.effect.id });\n  } catch (e) {\n    console.warn(\"Three Eyes: could not grant Acute Sense (Vision)\", e);\n  }\n})();",
            "label": "Acute Sense (Vision)",
